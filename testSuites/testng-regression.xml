<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite" 
       parallel="tests" 
       thread-count="2" 
       data-provider-thread-count="3">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
        <listener class-name="com.framework.listeners.SuiteListener"/>
        <listener class-name="com.framework.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Order Placement Tests">
        <classes>
            <class name="com.framework.tests.OrderPlacementTest"/>
        </classes>
    </test>

    <test name="Authentication Tests">
        <classes>
            <class name="com.framework.tests.AuthenticationTest"/>
        </classes>
    </test>

</suite>