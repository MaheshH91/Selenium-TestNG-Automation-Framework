<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Purchase Workflow Suite" parallel="tests" thread-count="2">

    <groups>
        <run>
            <include name="Purchase"/>
        </run>
    </groups>

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
        <listener class-name="com.framework.listeners.SuiteListener"/>
        <listener class-name="com.framework.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Purchase Flow Execution">
        <classes>
            <class name="com.framework.tests.OrderPlacementTest"/>
        </classes>
    </test>

</suite>