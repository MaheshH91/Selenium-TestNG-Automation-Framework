<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Error Handling Suite">

    <groups>
        <run>
            <include name="ErrorHandling"/>
        </run>
    </groups>

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
        <listener class-name="com.framework.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Authentication &amp; Cart Boundaries">
        <classes>
            <class name="com.framework.tests.AuthenticationTest"/>
        </classes>
    </test>

</suite>